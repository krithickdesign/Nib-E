{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nib-E",
  "version": "0.5.0",
  "identifier": "app.nib.pdfeditor",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nib-E",
        "width": 1320,
        "height": 860,
        "minWidth": 420,
        "minHeight": 420,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost data: blob:; worker-src 'self' blob:; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "Nib-E contributors",
    "copyright": "MIT License, Nib-E contributors",
    "category": "Productivity",
    "shortDescription": "Private PDF reader and editor",
    "longDescription": "Read, fill, sign, draw on, redact and organise PDFs. Works fully offline: no account, no uploads, no network access.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "office"
      }
    }
  }
}
